#!/bin/sh
set -eu

plymouth-set-default-theme eczos
test "$(readlink -f /usr/share/plymouth/debian-logo.png)" = \
    /usr/share/plymouth/themes/eczos/images/watermark.png
update-initramfs -u

if [ -f /etc/plymouth/plymouthd.conf ]; then
    grep -q '^Theme=eczos$' /etc/plymouth/plymouthd.conf
fi

if command -v lsinitramfs >/dev/null 2>&1; then
    initrd=$(find /boot -maxdepth 1 -type f -name 'initrd.img-*' -print | sort -V | tail -n 1)
    if [ -n "$initrd" ]; then
        lsinitramfs "$initrd" | grep -q \
            'usr/share/plymouth/themes/eczos/eczos.plymouth'
    fi
fi
