#!/bin/sh
set -eu

# ECZOS deliberately does not ship LibreOffice. FreeOffice image inclusion is
# handled separately because its signed vendor repository must be pinned for a
# reproducible public image.
installed=$(dpkg-query -W -f='${binary:Package} ${db:Status-Abbrev}\n' 'libreoffice*' 2>/dev/null \
    | awk '$2 == "ii" {print $1}' || true)
if [ -n "$installed" ]; then
    # shellcheck disable=SC2086
    apt-get purge -y $installed
fi

# ECZOS supplies its own complete first-login experience. Plasma Welcome is a
# recommendation rather than a desktop dependency, so removing it is safe and
# prevents two welcome assistants from opening for a new user.
if dpkg-query -W -f='${db:Status-Abbrev}\n' plasma-welcome 2>/dev/null | grep -q '^ii'; then
    apt-get purge -y plasma-welcome
fi

if command -v flatpak >/dev/null 2>&1; then
    flatpak remote-add --system --if-not-exists flathub \
        https://flathub.org/repo/flathub.flatpakrepo
fi
