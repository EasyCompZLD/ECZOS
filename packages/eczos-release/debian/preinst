#!/bin/sh
set -e

case "$1" in
    install|upgrade)
        for path in os-release issue issue.net motd; do
            if [ "$(dpkg-divert --listpackage "/etc/$path")" != eczos-release ]; then
                dpkg-divert \
                    --package eczos-release \
                    --add \
                    --rename \
                    --divert "/etc/$path.debian" \
                    "/etc/$path"
            fi
        done
        ;;
esac

#DEBHELPER#

exit 0
