#!/bin/sh
set -e

case "$1" in
    remove|abort-install)
        rm -f /etc/.os-release.eczos-new
        for path in os-release issue issue.net motd; do
            if [ "$(dpkg-divert --listpackage "/etc/$path")" = eczos-release ]; then
                rm -f "/etc/$path"
                dpkg-divert \
                    --package eczos-release \
                    --remove \
                    --rename \
                    --divert "/etc/$path.debian" \
                    "/etc/$path"
            fi
        done
        target=/etc/xdg/kcm-about-distrorc
        if [ "$(dpkg-divert --listpackage "$target")" = eczos-release ]; then
            rm -f "$target"
            dpkg-divert \
                --package eczos-release \
                --remove \
                --rename \
                --divert "$target.debian" \
                "$target"
        fi
        ;;
    purge)
        rm -f /etc/.os-release.eczos-new
        ;;
esac

#DEBHELPER#

exit 0
