#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -eq 0 && -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
    exec /usr/bin/eczos-ui support
fi

gui=true
case ${1:-} in
    --no-gui) gui=false ;;
    '') ;;
    -h|--help) printf 'Gebruik: eczos-support-report [--no-gui]\n'; exit 0 ;;
    *) printf 'Onbekende optie: %s\n' "$1" >&2; exit 2 ;;
esac

if [[ $(id -u) -eq 0 ]]; then
    printf 'Maak een supportrapport als de ingelogde gebruiker, niet als root.\n' >&2
    exit 2
fi

documents=$(xdg-user-dir DOCUMENTS 2>/dev/null || true)
[[ -n "$documents" && "$documents" != "$HOME" ]] || documents="$HOME"
mkdir -p "$documents"
output="$documents/ECZOS-supportrapport-$(date +%Y%m%d-%H%M%S).txt"
umask 077
{
    printf 'ECZOS supportrapport\nGemaakt: %s\n\n' "$(date --iso-8601=seconds)"
    printf '%s\n' '--- Systeem ---'
    grep -E '^(PRETTY_NAME|VARIANT|VERSION)=' /etc/os-release 2>/dev/null || true
    uname -srmo
    lscpu | grep -E '^(Architecture|Model name|CPU\(s\)):' || true
    printf '\n%s\n' '--- Geheugen en opslag ---'
    free -h
    lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS
    printf '\n%s\n' '--- Grafische hardware ---'
    lspci -nnk | awk '/VGA compatible controller|3D controller|Display controller/{print; keep=2; next} keep>0 {print; keep--}'
    printf '\n%s\n' '--- ECZOS onderdelen ---'
    eczos-doctor
    printf '\n%s\n' '--- Mislukte diensten ---'
    systemctl --failed --no-pager 2>&1 || true
    printf '\nDit rapport wordt niet automatisch verzonden. Controleer het voor delen.\n'
} > "$output"

printf 'Supportrapport opgeslagen: %s\n' "$output"
if [[ $gui == true && -n ${DISPLAY:-}${WAYLAND_DISPLAY:-} ]]; then
    kdialog --title 'ECZOS Ondersteuning' --msgbox "Het rapport is opgeslagen als:\n$output\n\nHet is niet automatisch verzonden."
fi
