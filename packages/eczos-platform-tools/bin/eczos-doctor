#!/usr/bin/env bash
set -Eeuo pipefail
export TEXTDOMAIN=${TEXTDOMAIN:-eczos-platform-tools}
export TEXTDOMAINDIR=${TEXTDOMAINDIR:-/usr/share/locale}
_() { gettext "$1"; }

json=false
gui=false
case ${1:-} in
    --json) json=true ;;
    --gui)
        exec /usr/bin/eczos-ui diagnostics
        ;;
    '') ;;
    *) printf '%s\n' "$(_ 'Usage: eczos-doctor [--json|--gui]')" >&2; exit 2 ;;
esac

package_ok() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -Fxq 'install ok installed'; }
yesno() { [[ $1 == true ]] && _ 'yes' || _ 'no'; }

windows=false
if command -v eczos-windows >/dev/null 2>&1 && \
    /usr/lib/eczos/windows/runtime-wine-system check >/dev/null 2>&1; then
    windows=true
fi
gaming_json='{"verdict":"not-installed"}'
if command -v eczos-gaming >/dev/null 2>&1; then
    gaming_json=$(eczos-gaming doctor --json 2>/dev/null || printf '{"verdict":"error"}')
fi
gaming_verdict=$(jq -r '.verdict // "error"' <<<"$gaming_json")
apps=false; package_ok plasma-discover && apps=true
flatpak=false; package_ok plasma-discover-backend-flatpak && flatpak=true
backup=false; package_ok kup-backup && backup=true
phone=false; package_ok kdeconnect && phone=true
firmware=false; package_ok fwupd && firmware=true
printer=false; package_ok cups && printer=true
scanner=false; package_ok skanpage && scanner=true
office=missing
office_label=$(_ 'not installed')
if package_ok softmaker-freeoffice-2024; then
    office=installed
    office_label=$(_ 'installed')
fi
failed_units=$(systemctl --failed --no-legend 2>/dev/null | wc -l | tr -d ' ')

if [[ $json == true ]]; then
    jq -n --argjson windows "$windows" --arg gaming "$gaming_verdict" \
        --argjson apps "$apps" --argjson flatpak "$flatpak" --argjson backup "$backup" \
        --argjson phone "$phone" --argjson firmware "$firmware" \
        --argjson printer "$printer" --argjson scanner "$scanner" --arg office "$office" \
        --argjson failedUnits "$failed_units" \
        '{schemaVersion:1, windows:$windows, gaming:$gaming, applications:{discover:$apps,flatpak:$flatpak},backup:$backup,phone:$phone,devices:{firmware:$firmware,printer:$printer,scanner:$scanner},office:$office,failedUnits:$failedUnits}'
    exit 0
fi

report=$(cat <<EOF
ECZOS $(_ 'Diagnostics')

$(_ 'Windows apps'): $(yesno "$windows")
$(_ 'Gaming'): $gaming_verdict
$(_ 'ECZ Apps'): $(yesno "$apps")
$(_ 'Flatpak integration'): $(yesno "$flatpak")
$(_ 'Backup'): $(yesno "$backup")
$(_ 'Phone integration'): $(yesno "$phone")
$(_ 'Firmware updates'): $(yesno "$firmware")
$(_ 'Printers'): $(yesno "$printer")
$(_ 'Scanners'): $(yesno "$scanner")
$(_ 'Office'): $office_label
$(_ 'Failed system services'): $failed_units
EOF
)

printf '%s\n' "$report"
