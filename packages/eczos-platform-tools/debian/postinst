#!/bin/sh
set -e

case "$1" in
    configure|triggered)
        systemctl --system daemon-reload >/dev/null 2>&1 || true
        systemctl --system enable eczos-remote-support-guard.service >/dev/null 2>&1 || true
        if [ -x /usr/lib/eczos-platform-tools/remote-support-guard ]; then
            /usr/lib/eczos-platform-tools/remote-support-guard apply --restart >/dev/null || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
