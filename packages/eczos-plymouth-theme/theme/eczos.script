Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.angle = 0;

fun center_logo()
  {
    logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
    logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
  }

fun refresh_callback()
  {
    center_logo();
    if (status == "normal")
      {
        logo.angle += 0.035;
        logo.sprite.SetOpacity(0.78 + 0.22 * ((Math.Cos(logo.angle) + 1) / 2));
      }
    else
      logo.sprite.SetOpacity(0.35);
  }

status = "normal";
Plymouth.SetRefreshFunction(refresh_callback);

prompt.sprite = Sprite();
prompt.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2,
                          Window.GetY() + Window.GetHeight() * 0.72, 10000);

bullets.sprite = Sprite();
bullets.sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2,
                           Window.GetY() + Window.GetHeight() * 0.77, 10000);

fun set_centered_text(sprite, text, y)
  {
    image = Image.Text(text, 1.0, 1.0, 1.0);
    sprite.SetImage(image);
    sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - image.GetWidth() / 2);
    sprite.SetY(y);
    sprite.SetOpacity(1);
  }

fun display_normal_callback()
  {
    global.status = "normal";
    prompt.sprite.SetOpacity(0);
    bullets.sprite.SetOpacity(0);
  }

fun display_password_callback(text, count)
  {
    global.status = "password";
    set_centered_text(prompt.sprite, text,
                      Window.GetY() + Window.GetHeight() * 0.72);
    bullet_text = "";
    for (index = 0; index < count; index++)
      bullet_text += "•";
    set_centered_text(bullets.sprite, bullet_text,
                      Window.GetY() + Window.GetHeight() * 0.77);
  }

fun display_question_callback(text, entry)
  {
    global.status = "question";
    set_centered_text(prompt.sprite, text,
                      Window.GetY() + Window.GetHeight() * 0.72);
    set_centered_text(bullets.sprite, entry,
                      Window.GetY() + Window.GetHeight() * 0.77);
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);

message.sprite = Sprite();
message.sprite.SetPosition(10, 10, 10000);

fun display_message_callback(text)
  {
    image = Image.Text(text, 1.0, 1.0, 1.0);
    message.sprite.SetImage(image);
    message.sprite.SetOpacity(1);
  }

fun hide_message_callback(text)
  {
    message.sprite.SetOpacity(0);
  }

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
