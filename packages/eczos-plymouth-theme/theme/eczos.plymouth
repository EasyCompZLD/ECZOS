[Plymouth Theme]
Name=ECZOS
Description=EasyComp Zeeland animated boot screen
ModuleName=two-step

[two-step]
Font=Cantarell 12
TitleFont=Cantarell Light 30
ImageDir=/usr/share/plymouth/themes/eczos/images
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.5
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.4
HorizontalAlignment=.5
VerticalAlignment=.5
WatermarkHorizontalAlignment=1.5
WatermarkVerticalAlignment=1.5
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x000000
BackgroundEndColor=0x000000
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.6
ProgressBarWidth=350
ProgressBarHeight=5
ProgressBarBackgroundColor=0x333333
ProgressBarForegroundColor=0x1e73be
DialogClearsFirmwareBackground=true
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=true
UseFirmwareBackground=false
SuppressMessages=true

[shutdown]
UseEndAnimation=false
UseFirmwareBackground=false

[reboot]
UseEndAnimation=false
UseFirmwareBackground=false

[updates]
UseFirmwareBackground=false
SuppressMessages=true
UseProgressBar=true
Title=Updates installeren…
SubTitle=Schakel de computer niet uit.

[system-upgrade]
UseFirmwareBackground=false
SuppressMessages=true
UseProgressBar=true
Title=Upgrades installeren…
SubTitle=Schakel de computer niet uit.

[firmware-upgrade]
UseFirmwareBackground=false
SuppressMessages=true
UseProgressBar=true
Title=Firmware bijwerken…
SubTitle=Schakel de computer niet uit.
