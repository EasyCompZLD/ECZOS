<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig><vendor>EasyComp Zeeland</vendor><vendor_url>https://easycompzeeland.nl/</vendor_url>
<action id="org.eczos.hardware.apply-profile"><description>Apply an ECZOS hardware profile</description><description xml:lang="nl">Een ECZOS-hardwareprofiel toepassen</description><message>Authentication is required to change memory management.</message><message xml:lang="nl">Authenticatie is nodig om het geheugenbeheer te wijzigen.</message><defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults><annotate key="org.freedesktop.policykit.exec.path">/usr/lib/eczos/hardware/apply-profile</annotate></action>
<action id="org.eczos.hardware.repair"><description>Repair a detected ECZOS hardware problem</description><description xml:lang="nl">Een gedetecteerd ECZOS-hardwareprobleem herstellen</description><description xml:lang="de">Ein erkanntes ECZOS-Hardwareproblem reparieren</description><description xml:lang="fr">Réparer un problème matériel détecté par ECZOS</description><message>Authentication is required to repair this hardware problem.</message><message xml:lang="nl">Authenticatie is nodig om dit hardwareprobleem te herstellen.</message><message xml:lang="de">Zur Reparatur dieses Hardwareproblems ist eine Authentifizierung erforderlich.</message><message xml:lang="fr">Une authentification est requise pour réparer ce problème matériel.</message><defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults><annotate key="org.freedesktop.policykit.exec.path">/usr/lib/eczos/hardware/repair-issue</annotate></action>
</policyconfig>
