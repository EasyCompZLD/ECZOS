<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>EasyComp Zeeland</vendor>
  <vendor_url>https://easycompzeeland.nl/</vendor_url>
  <action id="org.eczos.recoverymedia.write">
    <description>Write ECZOS recovery media</description>
    <description xml:lang="nl">ECZOS-herstelmedium schrijven</description>
    <description xml:lang="de">ECZOS-Wiederherstellungsmedium schreiben</description>
    <description xml:lang="fr">Écrire un support de récupération ECZOS</description>
    <message>Authentication is required to erase and write the selected medium.</message>
    <message xml:lang="nl">Authenticatie is nodig om het gekozen medium volledig te wissen en te schrijven.</message>
    <message xml:lang="de">Zum Löschen und Beschreiben des ausgewählten Mediums ist eine Authentifizierung erforderlich.</message>
    <message xml:lang="fr">Une authentification est requise pour effacer et écrire le support sélectionné.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/eczos-recovery-media/write-media</annotate>
  </action>
</policyconfig>
