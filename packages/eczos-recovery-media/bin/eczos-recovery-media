#!/usr/bin/env bash
set -Eeuo pipefail
export TEXTDOMAIN=${TEXTDOMAIN:-eczos-recovery-media}
export TEXTDOMAINDIR=${TEXTDOMAINDIR:-/usr/share/locale}
_() { gettext "$1"; }

if [[ ${1:-} == --self-test ]]; then
    for command_name in curl jq lsblk sha256sum xorriso pkexec eczos-ui; do
        command -v "$command_name" >/dev/null || { echo "missing: $command_name"; exit 1; }
    done
    [[ -x /usr/lib/eczos-recovery-media/write-media ]] || { echo 'missing: recovery writer'; exit 1; }
    echo 'ECZOS recovery media self-test passed'
    exit 0
fi
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    printf '%s\n' "$(_ 'Usage: eczos-recovery-media [--self-test]')"
    exit 0
fi

exec /usr/bin/eczos-ui recovery
