msgid "Usage: eczos-recovery-media [--self-test]"
msgstr "Gebruik: eczos-recovery-media [--self-test]"
msgid "ERROR"
msgstr "FOUT"
msgid "the writer must run as root through system authentication"
msgstr "de schrijver moet via systeemauthenticatie als root draaien"
msgid "invalid invocation"
msgstr "ongeldige aanroep"
msgid "the installation image is not readable"
msgstr "de installatiekopie is niet leesbaar"
msgid "the target is not a block device"
msgstr "het doel is geen blokapparaat"
msgid "the system drive is never overwritten"
msgstr "de systeemschijf wordt nooit overschreven"
msgid "the installation image is stored on the selected target medium"
msgstr "de installatiekopie staat op het gekozen doelmedium"
msgid "select the complete USB drive or SD card"
msgstr "kies de volledige USB-schijf of SD-kaart"
msgid "only a removable USB drive or SD card is allowed"
msgstr "alleen een verwisselbare USB-schijf of SD-kaart is toegestaan"
msgid "the target medium is smaller than the installation image"
msgstr "het doelmedium is kleiner dan de installatiekopie"
#, sh-printf-format
msgid "Validation passed: %s can be written to %s."
msgstr "Validatie geslaagd: %s kan naar %s worden geschreven."
#, sh-printf-format
msgid "cannot unmount %s"
msgstr "kan %s niet ontkoppelen"
#, sh-printf-format
msgid "Writing to %s. This may take some time..."
msgstr "Schrijven naar %s. Dit kan enige tijd duren..."
msgid "Preparing recovery media…"
msgstr "Herstelmedium voorbereiden…"
msgid "Writing recovery media…"
msgstr "Herstelmedium schrijven…"
msgid "about"
msgstr "ongeveer"
msgid "min remaining"
msgstr "min resterend"
msgid "the target is not an optical drive"
msgstr "het doel is geen optisch station"
#, sh-printf-format
msgid "Validation passed: %s can be burned to %s."
msgstr "Validatie geslaagd: %s kan naar %s worden gebrand."
#, sh-printf-format
msgid "Burning to %s. This may take some time..."
msgstr "Branden naar %s. Dit kan enige tijd duren..."
msgid "Burning disc… this may take some time"
msgstr "Schijf branden… dit kan enige tijd duren"
msgid "Burning disc…"
msgstr "Schijf branden…"
msgid "unknown media type"
msgstr "onbekend mediatype"
msgid "Done. The ECZOS recovery medium has been written and can be removed safely."
msgstr "Klaar. Het ECZOS-herstelmedium is geschreven en kan veilig worden verwijderd."
msgid "Done. The recovery medium can be removed safely."
msgstr "Klaar. Het herstelmedium kan veilig worden verwijderd."
