msgid "Usage: eczos-gaming COMMAND"
msgstr "Utilisation : eczos-gaming COMMANDE"
msgid "Check GPU, Vulkan, 32-bit drivers and runtimes"
msgstr "Vérifier le GPU, Vulkan, les pilotes 32 bits et les environnements"
msgid "Same as doctor"
msgstr "Identique à doctor"
msgid "Succeed only when Proton gaming is fully ready"
msgstr "Réussir uniquement lorsque Proton est entièrement prêt pour le jeu"
msgid "Show the status graphically"
msgstr "Afficher l’état graphiquement"
msgid "Show the pinned UMU runtime information"
msgstr "Afficher les informations de l’environnement UMU épinglé"
msgid "Unknown graphics adapter"
msgstr "Carte graphique inconnue"
msgid "No Vulkan device found"
msgstr "Aucun périphérique Vulkan trouvé"
msgid "Not suitable for Proton/DXVK: no Vulkan GPU was found."
msgstr "Non adapté à Proton/DXVK : aucun GPU Vulkan n’a été trouvé."
msgid "A suitable Vulkan GPU was found, but the gaming runtime is not complete yet."
msgstr "Un GPU Vulkan adapté a été trouvé, mais l’environnement de jeu n’est pas encore complet."
msgid "This computer is technically ready for ECZ Gaming."
msgstr "Cet ordinateur est techniquement prêt pour ECZ Gaming."
msgid "no"
msgstr "non"
msgid "yes"
msgstr "oui"
msgid "ECZ Gaming check"
msgstr "Vérification ECZ Gaming"
msgid "Result"
msgstr "Résultat"
msgid "Vulkan device"
msgstr "Périphérique Vulkan"
msgid "Hardware Vulkan"
msgstr "Vulkan matériel"
msgid "32-bit Vulkan driver"
msgstr "Pilote Vulkan 32 bits"
msgid "UMU/Proton adapter"
msgstr "Adaptateur UMU/Proton"
msgid "Memory"
msgstr "Mémoire"
msgid "Warning: less than 8 GiB RAM; modern games may use swap heavily."
msgstr "Avertissement : moins de 8 Gio de RAM ; les jeux modernes peuvent utiliser intensivement l’espace d’échange."
msgid "Warning: this CPU has no AVX; many modern games will not start."
msgstr "Avertissement : ce processeur ne prend pas en charge AVX ; de nombreux jeux modernes ne démarreront pas."
msgid "Note: llvmpipe/lavapipe is software rendering and does not count as a gaming GPU."
msgstr "Remarque : llvmpipe/lavapipe est un rendu logiciel et ne compte pas comme GPU de jeu."
