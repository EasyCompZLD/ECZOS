msgid "Usage: eczos-gaming COMMAND"
msgstr "Gebruik: eczos-gaming OPDRACHT"
msgid "Check GPU, Vulkan, 32-bit drivers and runtimes"
msgstr "Controleer GPU, Vulkan, 32-bit drivers en runtimes"
msgid "Same as doctor"
msgstr "Hetzelfde als doctor"
msgid "Succeed only when Proton gaming is fully ready"
msgstr "Slaag alleen wanneer Proton-gaming volledig gereed is"
msgid "Show the status graphically"
msgstr "Toon de status grafisch"
msgid "Show the pinned UMU runtime information"
msgstr "Toon de vastgelegde UMU-runtime-informatie"
msgid "Unknown graphics adapter"
msgstr "Onbekende grafische adapter"
msgid "No Vulkan device found"
msgstr "Geen Vulkan-apparaat gevonden"
msgid "Not suitable for Proton/DXVK: no Vulkan GPU was found."
msgstr "Niet geschikt voor Proton/DXVK: geen Vulkan-GPU gevonden."
msgid "A suitable Vulkan GPU was found, but the gaming runtime is not complete yet."
msgstr "Geschikte Vulkan-GPU gevonden, maar de gaming-runtime is nog niet compleet."
msgid "This computer is technically ready for ECZ Gaming."
msgstr "Deze computer is technisch klaar voor ECZ Gaming."
msgid "no"
msgstr "nee"
msgid "yes"
msgstr "ja"
msgid "ECZ Gaming check"
msgstr "ECZ Gaming-controle"
msgid "Result"
msgstr "Resultaat"
msgid "Vulkan device"
msgstr "Vulkan-apparaat"
msgid "Hardware Vulkan"
msgstr "Hardware-Vulkan"
msgid "32-bit Vulkan driver"
msgstr "32-bit Vulkan-driver"
msgid "UMU/Proton adapter"
msgstr "UMU/Proton-adapter"
msgid "Memory"
msgstr "Werkgeheugen"
msgid "Warning: less than 8 GiB RAM; modern games may use swap heavily."
msgstr "Waarschuwing: minder dan 8 GiB RAM; moderne games kunnen zwaar wisselgeheugen gebruiken."
msgid "Warning: this CPU has no AVX; many modern games will not start."
msgstr "Waarschuwing: deze CPU heeft geen AVX; veel moderne games starten daardoor niet."
msgid "Note: llvmpipe/lavapipe is software rendering and does not count as a gaming GPU."
msgstr "Let op: llvmpipe/lavapipe is software-rendering en telt niet als gaming-GPU."
