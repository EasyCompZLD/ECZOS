#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_HOME=${XDG_CONFIG_HOME:-"$HOME/.config"}
MODE_FILE="$CONFIG_HOME/eczos/theme-mode"
CURRENT_MODE=nightlight

if [[ -s "$MODE_FILE" ]]; then
    CURRENT_MODE=$(cat "$MODE_FILE")
fi

case "$CURRENT_MODE" in
    default) NEXT_MODE=light ;;
    auto|nightlight) NEXT_MODE=light ;;
    light) NEXT_MODE=dark ;;
    dark) NEXT_MODE=nightlight ;;
    *) NEXT_MODE=nightlight ;;
esac

exec eczos-theme-switch "$NEXT_MODE"
